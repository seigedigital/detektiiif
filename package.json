{
    "name": "detektIIIF3",
    "version": "4.0.0",
    "description": "detektIIIF browser extension.",
    "license": "GPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "https://github.com/seigedigital/detektiiif3.git"
    },
    "scripts": {
        "build": "node utils/build-all.js",
        "build:chrome": "node utils/build.js chrome",
        "build:firefox": "node utils/build.js firefox",
        "start": "node utils/webserver.js chrome",
        "start:chrome": "node utils/webserver.js chrome",
        "start:firefox": "node utils/webserver.js firefox",
        "package": "node utils/package-all.js",
        "package:chrome": "node utils/package-all.js chrome",
        "package:firefox": "node utils/package-all.js firefox",
        "test:chrome": "npm run build:chrome && playwright test tests/chrome-extension.spec.js",
        "lint:firefox": "npm run build:firefox && web-ext lint --source-dir build/firefox --boring",
        "run:firefox": "npm run build:firefox && web-ext run --source-dir build/firefox",
        "buildv3": "node utils/build.js chrome",
        "startv3": "node utils/webserver.js chrome",
        "prettier": "prettier --write '**/*.{js,jsx,ts,tsx,json,css,scss,md}'"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^7.3.11",
        "@mui/material": "^7.3.11",
        "@mui/styled-engine": "^7.3.10",
        "@mui/system": "^7.3.11",
        "i18next": "^26.4.2",
        "lodash": "^4.18.1",
        "manifesto.js": "^4.3.5",
        "mirador": "^4.2.4",
        "mirador-annotation-editor": "^1.3.3",
        "prop-types": "^15.8.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-i18next": "^17.0.13",
        "react-lazy-load-image-component": "^1.6.3",
        "uuid": "^11.1.1"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-react": "^7.29.7",
        "@playwright/test": "^1.62.1",
        "babel-loader": "^8.4.1",
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^6.11.0",
        "file-loader": "^6.2.0",
        "fs-extra": "^11.4.0",
        "html-loader": "^3.1.0",
        "html-webpack-plugin": "^5.6.8",
        "prettier": "^2.8.8",
        "sass": "^1.103.1",
        "sass-loader": "^17.0.1",
        "source-map-loader": "^3.0.1",
        "style-loader": "^3.3.1",
        "terser-webpack-plugin": "^5.6.1",
        "web-ext": "^10.6.0",
        "webpack": "^5.110.3",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^6.0.0"
    },
    "overrides": {
        "dompurify": "^3.4.14"
    }
